```gitignore
# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# VS Code
.vscode/

# PyCharm
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Log files
*.log

# Environment variables
.env

# Build files
build/
dist/
*.egg-info/

# Coverage reports
.coverage
htmlcov/
.pytest_cache/

# Temporary files
*.tmp
*.temp
```
